<view class="login-page">
  <view class="hero">
    <view class="blob blob-1"></view>
    <view class="blob blob-2"></view>
    <view class="hero-inner" style="padding-top: {{heroPadding}}px">
      <image class="logo" src="/images/logo.png" mode="aspectFit" />
      <view class="app-name">衣橱穿搭</view>
      <view class="app-slogan">拍照收纳 · 天气穿搭 · AI 搭配</view>
    </view>
  </view>

  <view class="sheet">
    <view class="sheet-title">欢迎回来</view>
    <view class="sheet-desc">登录后即可使用全部功能，每个账号的衣橱相互独立</view>

    <button
      class="btn btn-accent btn-block wx-btn"
      bindtap="onWechatLogin"
      loading="{{wechatLoading}}"
      disabled="{{wechatLoading}}"
    >{{wechatLoading ? '登录中…' : '微信一键登录'}}</button>

    <view class="divider">
      <view class="divider-line"></view>
      <text class="divider-text">其他方式</text>
      <view class="divider-line"></view>
    </view>

    <view wx:if="{{!showPhone}}" class="chip chip-soft phone-entry" bindtap="togglePhone">手机号登录 / 注册</view>

    <view wx:else class="phone-form">
      <view class="field {{focus === 'phone' ? 'field-focus' : ''}}">
        <input
          type="number"
          maxlength="11"
          placeholder="请输入 11 位手机号"
          placeholder-class="ph"
          value="{{phone}}"
          bindinput="onPhoneInput"
          bindfocus="onFocus"
          bindblur="onBlur"
          data-name="phone"
        />
      </view>
      <view wx:if="{{phoneError}}" class="field-error">{{phoneError}}</view>

      <view class="field code-field {{focus === 'code' ? 'field-focus' : ''}}">
        <input
          type="number"
          maxlength="6"
          placeholder="请输入验证码"
          placeholder-class="ph"
          value="{{code}}"
          bindinput="onCodeInput"
          bindfocus="onFocus"
          bindblur="onBlur"
          data-name="code"
        />
        <view
          class="code-btn {{canSendCode ? '' : 'disabled'}}"
          bindtap="onSendCode"
        >{{countdown > 0 ? countdown + 's 后重发' : (sending ? '发送中…' : '获取验证码')}}</view>
      </view>

      <button
        class="btn btn-primary btn-block submit-btn"
        bindtap="onSubmit"
        loading="{{submitting}}"
        disabled="{{submitting}}"
      >{{submitting ? '处理中…' : '登录 / 注册'}}</button>

      <view class="phone-hint">未注册的手机号将自动创建账号</view>
    </view>

    <view class="agree" bindtap="toggleAgree">
      <view class="checkbox {{agreed ? 'checked' : ''}}"></view>
      <view class="agree-text">我已阅读并同意《用户协议》与《隐私政策》</view>
    </view>
  </view>
</view>
