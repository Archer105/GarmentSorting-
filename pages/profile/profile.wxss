.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 80rpx;
}

/* ---------------- 顶部 ---------------- */
.hero {
  position: relative;
  padding: 24rpx 32rpx 40rpx;
  background: linear-gradient(150deg, #8b6bff 0%, #6b4eff 50%, #5433e0 100%);
  border-radius: 0 0 40rpx 40rpx;
  overflow: hidden;
}

.blob {
  position: absolute;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  top: -140rpx;
  right: -100rpx;
}

.hero-top {
  position: relative;
  z-index: 2;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.user-card {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 26rpx;
  margin-top: 36rpx;
}

.avatar {
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  color: #fff;
  font-size: 48rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.edit-hint {
  margin-left: 12rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.22);
  font-size: 21rpx;
  font-weight: 400;
}

.user-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.stat-row {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  margin-top: 40rpx;
  background: rgba(255, 255, 255, 0.16);
  border-radius: var(--radius-md);
  padding: 24rpx 0;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.stat-line {
  width: 1rpx;
  height: 52rpx;
  background: rgba(255, 255, 255, 0.25);
}

/* ---------------- 内容 ---------------- */
.section-title {
  margin: 40rpx 0 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.tip-card {
  font-size: 26rpx;
  color: var(--text-2);
}

.link {
  color: var(--brand);
}

.record-card {
  margin-top: 20rpx;
}

.record-title {
  font-size: 30rpx;
  font-weight: 600;
}

.record-del {
  font-size: 24rpx;
  color: var(--muted);
  padding: 6rpx 16rpx;
}

.record-meta {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: var(--muted);
}

.record-advice {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
  font-size: 25rpx;
  color: var(--text-2);
  line-height: 1.65;
}

.menu-card {
  padding: 8rpx 32rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 104rpx;
  font-size: 28rpx;
  border-bottom: 1rpx solid var(--line);
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-arrow {
  color: var(--muted);
  font-size: 32rpx;
}

.logout {
  margin-top: 48rpx;
  color: var(--danger);
  border-color: #ffe1e2;
}

/* ---------------- 弹层 ---------------- */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 20, 32, 0.42);
  z-index: 100;
}

.sheet-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.panel-close {
  font-size: 26rpx;
  color: var(--muted);
}

.panel-label {
  margin: 32rpx 0 16rpx;
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 600;
}

.ph {
  color: #b9bdcb;
  font-size: 28rpx;
}

.save {
  margin-top: 44rpx;
}
