<view class="page page-enter" wx:if="{{item}}">
  <view class="hero">
    <image class="hero-img" src="{{thumb}}" mode="aspectFill" />
    <view class="hero-badge">{{item.category}}</view>
  </view>

  <view class="container">
    <view class="card">
      <view class="h1 name">{{item.name}}</view>
      <view class="meta-row">
        <view wx:if="{{item.color}}" class="meta-pill">主色 · {{item.color}}</view>
        <view wx:if="{{item.season}}" class="meta-pill">季节 · {{item.season}}</view>
      </view>

      <view wx:if="{{item.tags.length}}" class="tag-row">
        <view wx:for="{{item.tags}}" wx:key="*this" class="tag">{{item}}</view>
      </view>

      <view wx:if="{{item.note}}" class="note">{{item.note}}</view>

      <view class="created">收录于 {{createdText}}</view>
    </view>

    <button class="btn btn-primary btn-block act" bindtap="onStyleIt">让 AI 围绕这件搭一套</button>
    <button class="btn btn-ghost btn-block act" bindtap="onEdit">编辑单品</button>
    <button class="btn btn-plain btn-block act del" bindtap="onDelete">删除</button>
  </view>
</view>

<view class="page page-enter" wx:else>
  <view class="empty">
    <view class="empty-title">{{loading ? '加载中…' : '单品不存在或无权访问'}}</view>
  </view>
</view>
