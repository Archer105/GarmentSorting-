<view class="page">
  <view class="head">
    <view class="field search-field">
      <text class="search-icon">🔍</text>
      <input
        placeholder="搜索名称、颜色、标签"
        placeholder-class="ph"
        value="{{keyword}}"
        bindinput="onSearch"
        confirm-type="search"
      />
      <view wx:if="{{keyword}}" class="clear" bindtap="clearSearch">✕</view>
    </view>

    <scroll-view scroll-x class="cat-scroll" enhanced show-scrollbar="{{false}}">
      <view class="cat-list">
        <view
          wx:for="{{categoryTabs}}"
          wx:key="key"
          class="chip {{category === item.key ? 'active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onPickCategory"
        >{{item.icon ? item.icon + ' ' : ''}}{{item.key}}</view>
      </view>
    </scroll-view>

    <!-- 标签交叉筛选：可多选，需同时命中 -->
    <view wx:if="{{tagOptions.length}}" class="tag-bar">
      <view class="tag-bar-head">
        <text class="tag-bar-title">标签筛选</text>
        <text class="tag-bar-hint">{{tagFilterActive ? '已选 ' + activeTags.length + ' 个 · 需同时命中' : '可多选，交叉筛选'}}</text>
        <text wx:if="{{tagFilterActive}}" class="tag-bar-clear" bindtap="clearTags">清除</text>
      </view>
      <scroll-view scroll-x class="tag-scroll" enhanced show-scrollbar="{{false}}">
        <view class="tag-list">
          <view
            wx:for="{{tagOptions}}"
            wx:key="name"
            class="chip tag-chip {{item.active ? 'active' : ''}}"
            data-key="{{item.name}}"
            bindtap="onPickTag"
          >{{item.name}}<text class="tag-count">{{item.count}}</text></view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="body">
    <view wx:if="{{loading}}" class="empty">
      <view class="empty-title">加载中…</view>
    </view>

    <view wx:elif="{{!list.length}}" class="empty">
      <view class="empty-emoji">🧺</view>
      <view class="empty-title">{{keyword || category !== '全部' || tagFilterActive ? '没有找到符合条件的单品' : '衣橱还空着'}}</view>
      <view class="empty-desc">{{keyword || category !== '全部' || tagFilterActive ? '换个关键词、分类或标签组合试试' : '拍几张照片，把常穿的衣服收进来'}}</view>
      <button wx:if="{{tagFilterActive}}" class="btn btn-ghost empty-btn" bindtap="clearTags">清除标签筛选</button>
      <button wx:elif="{{!keyword && category === '全部'}}" class="btn btn-primary empty-btn" bindtap="goAdd">上传第一件</button>
    </view>

    <view wx:else class="grid">
      <view
        wx:for="{{list}}"
        wx:key="id"
        class="g-item"
        data-id="{{item.id}}"
        bindtap="goDetail"
      >
        <view class="g-img-wrap">
          <image class="g-img" src="{{item.thumb}}" mode="aspectFill" lazy-load />
          <view class="g-cat">{{item.category}}</view>
        </view>
        <view class="g-name ellipsis">{{item.name}}</view>
        <view class="g-meta ellipsis">{{item.meta}}</view>
      </view>
    </view>
  </view>

  <view class="fab" bindtap="goAdd">＋</view>
</view>
